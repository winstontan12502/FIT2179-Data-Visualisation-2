
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Year-on-year percentage changes in domestic overnight trips and nominal expenditure across Australian states and territories. Source: Tourism Research Australia, June quarter 2026.",
  "width": "container",
  "height": 350,
  "background": "transparent",
  "data": {
    "url": "domestic_trips_spending_change.csv",
    "format": {
      "type": "csv",
      "parse": {
        "change_pct": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "isValid(datum.state) && indexof(['New South Wales', 'Victoria', 'Queensland', 'South Australia', 'Western Australia', 'Tasmania', 'Northern Territory', 'Australian Capital Territory'], datum.state) >= 0"
    }
  ],
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "scale": {
        "domain": [
          "New South Wales",
          "Victoria",
          "Queensland",
          "South Australia",
          "Western Australia",
          "Tasmania",
          "Northern Territory",
          "Australian Capital Territory"
        ]
      },
      "sort": [
        "New South Wales",
        "Victoria",
        "Queensland",
        "South Australia",
        "Western Australia",
        "Tasmania",
        "Northern Territory",
        "Australian Capital Territory"
      ],
      "title": null,
      "axis": {
        "labelLimit": 190,
        "labelFontSize": 11,
        "ticks": false,
        "domain": false
      }
    }
  },
  "layer": [
    {
      "transform": [
        {
          "pivot": "indicator",
          "value": "change_pct",
          "groupby": ["state"]
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#CBD5D6",
        "strokeWidth": 3
      },
      "encoding": {
        "x": {
          "field": "Overnight trips",
          "type": "quantitative",
          "title": "Year-on-year change (%)",
          "scale": {
            "domain": [-8, 20],
            "zero": true
          },
          "axis": {
            "grid": true,
            "gridColor": "#E6ECEB",
            "tickCount": 8
          }
        },
        "x2": {
          "field": "Overnight expenditure"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 110
      },
      "encoding": {
        "x": {
          "field": "change_pct",
          "type": "quantitative"
        },
        "color": {
          "field": "indicator",
          "type": "nominal",
          "scale": {
            "domain": [
              "Overnight trips",
              "Overnight expenditure"
            ],
            "range": [
              "#187F83",
              "#D19A61"
            ]
          },
          "legend": {
            "title": null,
            "orient": "bottom",
            "direction": "horizontal"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State or territory"
          },
          {
            "field": "indicator",
            "type": "nominal",
            "title": "Indicator"
          },
          {
            "field": "change_pct",
            "type": "quantitative",
            "title": "Year-on-year change (%)",
            "format": "+.1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelColor": "#597078",
      "titleColor": "#102D3C",
      "gridColor": "#E6ECEB",
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "DM Sans",
      "titleFont": "DM Sans",
      "labelColor": "#597078"
    }
  }
}
